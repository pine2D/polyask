.DS_Store

# docs/ 默认忽略历史草稿、本地素材与临时方案，仅按文件白名单入库。
# 白名单仅保留文档索引、开发/发布契约及被发布说明引用的历史报告。
# 产品调研、设计/实施计划、mockup 和资源采样仅本地保存，不加入白名单。
# 入库文档引用的本地文件也须入库，scripts/verify.sh 按 git ls-files 检查引用。
/docs/*

# 开发契约与发布历史
!/docs/README.md
!/docs/adapters.md
!/docs/audit-2026-07.md
!/docs/desktop.md
!/docs/desktop-oauth-security.md
!/docs/release.md
!/docs/verify.md

# 本地工具状态
.superpowers/
.spec-workflow/
.codegraph/
.serena/

# 项目级 Impeccable：安装载荷和引擎可重建，来源与操作说明入库。
/.agents/skills/impeccable/
/.agents/skills/native-feel-cross-platform-desktop/
/.impeccable/cache/
/.impeccable/config.local.json
/.impeccable/critique/
/.impeccable/live/

# 打包产物
dist/
desktop/.webpack/
desktop/out/
desktop/release/
desktop/node_modules/
desktop/resources/oauth.json

# 本地调试脚本
scratchpad/
